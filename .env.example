# ============================================
# نمونه تنظیمات محیط - کپی به .env.local و مقادیر را پر کنید
# Copy to .env.local and fill in values
# ============================================

NODE_ENV=development
PORT=3000

# آدرس سایت (لوکال: http://localhost:3000)
NEXT_PUBLIC_URL=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=saded
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# درگاه پرداخت زرین‌پال (اختیاری برای لوکال)
